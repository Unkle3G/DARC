# Beijing time. The daily report must be on the desk before 08:00, and the US
# trading day it covers closes at 05:00 Beijing (04:00 during DST), so 06:30
# leaves room for a retry.
#
#   crontab -e   (with TZ=Asia/Shanghai in the crontab, or convert to the host TZ)
CRON_TZ=Asia/Shanghai
30 6 * * 1-5 /path/to/liver-intel/scripts/run_daily.sh >> /var/log/liver-intel.log 2>&1

# Re-verify the feed registry weekly: wires retire feed URLs without notice, and
# a dead endpoint must fall out of `verified` rather than fail silently.
0 5 * * 6 cd /path/to/liver-intel && python3 -m liver_intel.cli verify --recheck >> /var/log/liver-intel-verify.log 2>&1
